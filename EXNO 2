import numpy as np

states = ["Sunny", "Cloudy", "Rainy"]

observations = ["Dry", "Humid", "Wet"]

transition = np.array([
    [0.7, 0.2, 0.1],
    [0.2, 0.6, 0.2],
    [0.1, 0.3, 0.6]
])

emission = np.array([
    [0.8, 0.15, 0.05],
    [0.2, 0.6, 0.2],
    [0.05, 0.25, 0.7]
])

initial = np.array([0.5, 0.3, 0.2])

observation_sequence = ["Dry", "Humid", "Wet", "Wet", "Humid"]

obs = [observations.index(x) for x in observation_sequence]

n = len(obs)

dp = np.zeros((n, len(states)))
path = np.zeros((n, len(states)), dtype=int)

dp[0] = initial * emission[:, obs[0]]

for t in range(1, n):
    for j in range(len(states)):
        probabilities = dp[t-1] * transition[:, j]
        path[t, j] = np.argmax(probabilities)
        dp[t, j] = np.max(probabilities) * emission[j, obs[t]]

best_path = np.zeros(n, dtype=int)

best_path[-1] = np.argmax(dp[-1])

for t in range(n - 2, -1, -1):
    best_path[t] = path[t + 1, best_path[t + 1]]

predicted_states = [states[i] for i in best_path]

print("Observation Sequence:")
print(observation_sequence)

print("\nPredicted Hidden States:")
print(predicted_states)
