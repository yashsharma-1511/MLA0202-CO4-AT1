import sklearn_crfsuite

train_sentences = [
    ["Rahul", "ordered", "Laptop", "with", "order", "ORD123"],
    ["Priya", "bought", "Phone", "order", "ORD456"],
    ["Arun", "purchased", "Headphones", "order", "ORD789"],
    ["Sneha", "ordered", "Tablet", "with", "order", "ORD321"]
]

train_labels = [
    ["CUSTOMER", "O", "PRODUCT", "O", "O", "ORDER_ID"],
    ["CUSTOMER", "O", "PRODUCT", "O", "ORDER_ID"],
    ["CUSTOMER", "O", "PRODUCT", "O", "ORDER_ID"],
    ["CUSTOMER", "O", "PRODUCT", "O", "O", "ORDER_ID"]
]

def word_features(sentence, i):
    word = sentence[i]

    features = {
        "word.lower()": word.lower(),
        "word.isupper()": word.isupper(),
        "word.istitle()": word.istitle(),
        "word.isdigit()": word.isdigit(),
        "word.startswith('ORD')": word.startswith("ORD")
    }

    if i > 0:
        features["previous_word"] = sentence[i - 1].lower()
    else:
        features["BOS"] = True

    if i < len(sentence) - 1:
        features["next_word"] = sentence[i + 1].lower()
    else:
        features["EOS"] = True

    return features

X_train = []
y_train = []

for sentence, labels in zip(train_sentences, train_labels):
    X_train.append([
        word_features(sentence, i)
        for i in range(len(sentence))
    ])
    y_train.append(labels)

crf = sklearn_crfsuite.CRF(
    algorithm="lbfgs",
    max_iterations=100,
    all_possible_transitions=True
)

crf.fit(X_train, y_train)

test_sentence = [
    "Vikram",
    "ordered",
    "Laptop",
    "with",
    "order",
    "ORD999"
]

X_test = [[
    word_features(test_sentence, i)
    for i in range(len(test_sentence))
]]

prediction = crf.predict(X_test)[0]

print("Sentence:")
print(test_sentence)

print("\nPredicted Entity Labels:")

for word, label in zip(test_sentence, prediction):
    print(word, "->", label)
